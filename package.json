{
  "name": "jarlbot",
  "version": "1.7.7",
  "description": "Discord bot and local launcher for EVA community administration.",
  "main": "index.js",
  "author": "Gavr0che",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gavr0che50/JarlBot.git"
  },
  "bugs": {
    "url": "https://github.com/Gavr0che50/JarlBot/issues"
  },
  "homepage": "https://github.com/Gavr0che50/JarlBot#readme",
  "scripts": {
    "start": "node index.js",
    "pack:dist": "npm pack --pack-destination dist",
    "eva-refresh": "node scripts/eva-refresh.js",
    "eva-refresh:full": "node scripts/eva-refresh.js --full",
    "eva-refresh:reset": "node scripts/eva-refresh.js --reset --full",
    "launcher": "node scripts/launcher.js",
    "export-portable": "node scripts/export-portable.js",
    "deploy-commands": "node deploy-commands.js",
    "check": "node --check index.js && node --check config.js && node --check deploy-commands.js && node --check scripts/launcher.js && node --check scripts/export-portable.js && node --check scripts/eva-refresh.js && node --check utils/eva-v2.js && node --check utils/storage.js",
    "test": "npm run check"
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "index.js",
    "config.js",
    "deploy-commands.js",
    "scripts/",
    "utils/",
    "README.md",
    "INSTALLATION-WINDOWS.md",
    "INSTALLATION-LINUX.md",
    "troubleshoot.md",
    "LICENSE",
    "JarlBot Launcher.cmd",
    "launcher.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "node-schedule": "^2.1.1"
  }
}
